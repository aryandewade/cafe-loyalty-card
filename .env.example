# Atelier Café — Environment Configuration
# Copy this file to .env and insert your credentials

PORT=8787
NODE_ENV=production

# --------------------------------------------------------------------------
# SUPABASE POSTGRESQL CLOUD DATABASE (Recommended for Production & Cloud Hosting)
# 1. Sign up for free at https://supabase.com
# 2. Create a new project (e.g., "atelier-loyalty")
# 3. In Supabase Dashboard, go to "Project Settings" -> "API" / "Data API"
# 4. Copy Project URL and publishable / secret keys below:
# --------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Traditional JWT format (also supported):
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Master HMAC secret for dynamic 90s anti-screenshot QR passes
SERVER_SECRET=atelier_cafe_production_master_secret_2026
